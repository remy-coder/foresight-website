{
  "redirects": [
    {
      "source": "/sumba-eye-program",
      "destination": "/where-we-work/sumba",
      "permanent": true
    },
    {
      "source": "/sumba-eye-program/",
      "destination": "/where-we-work/sumba",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*\\.vercel\\.app|foresight-website-eight\\.vercel\\.app)"
        }
      ],
      "headers": [
        {
          "key": "x-robots-tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
